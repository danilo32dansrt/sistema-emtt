# Copie este arquivo para .env e preencha. NUNCA envie o .env para o Git.

# Banco PostgreSQL (Supabase: Project Settings > Database > Connection string)
# DATABASE_URL usa o pooler (porta 6543) e DIRECT_URL a conexão direta (porta 5432).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/esocial?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/esocial?schema=public"

# Segredo para assinar as sessões de login (gere com: openssl rand -base64 48)
AUTH_SECRET="troque-por-um-segredo-longo-e-aleatorio-com-pelo-menos-32-caracteres"

# Segredo usado pela rotina diária de alertas (Vercel Cron envia como Bearer)
CRON_SECRET="troque-este-segredo"

# Opcional: envio de e-mails de lembrete pelo Resend (https://resend.com)
RESEND_API_KEY=""
EMAIL_REMETENTE="Consultoria <lembretes@seudominio.com.br>"

# Endereço público do sistema (usado em links de e-mail)
APP_URL="http://localhost:3000"
