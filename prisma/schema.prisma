// Banco de dados do Sistema de Gestão eSocial Doméstico.
// Funciona com qualquer PostgreSQL (Supabase recomendado).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Papel {
  CONSULTOR
  CLIENTE
  EMPREGADO
}

enum StatusProcuracao {
  PENDENTE
  ATIVA
  VENCIDA
}

enum Regime {
  INTEGRAL
  PARCIAL
  DOZE_X_TRINTA_SEIS
}

enum SituacaoEmpregado {
  ATIVO
  AFASTADO
  DESLIGADO
}

enum TipoMarcacao {
  ENTRADA
  SAIDA_INTERVALO
  RETORNO_INTERVALO
  SAIDA
}

enum StatusSolicitacao {
  PENDENTE
  APROVADO
  REJEITADO
}

/// Plano contratado pelo empregador
enum PlanoCliente {
  BASICO
  MEDIO
  PLUS
}

enum StatusCobranca {
  ABERTO
  PAGO
  CANCELADO
}

enum StatusLead {
  NOVO
  CONTATO
  PROPOSTA
  NEGOCIACAO
  GANHO
  PERDIDO
}

// ---------------------------------------------------------------------------
// Acesso
// ---------------------------------------------------------------------------

model Usuario {
  id                  String     @id @default(cuid())
  email               String     @unique
  senhaHash           String
  nome                String
  papel               Papel
  clienteId           String?
  cliente             Cliente?   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  empregadoId         String?    @unique
  empregado           Empregado? @relation(fields: [empregadoId], references: [id], onDelete: Cascade)
  ativo               Boolean    @default(true)
  tentativasFalhas    Int        @default(0)
  bloqueadoAte        DateTime?
  trocarSenha         Boolean    @default(false)
  ultimoAcesso        DateTime?
  consentimentoLgpdEm DateTime?
  criadoEm            DateTime   @default(now())
  atualizadoEm        DateTime   @updatedAt

  atividades  Atividade[]
  mensagens   Mensagem[]
  assinaturas Assinatura[]
  inscricoesPush InscricaoPush[]
  notificacoes   Notificacao[]

  @@index([clienteId])
}

model AcessoLog {
  id        String   @id @default(cuid())
  usuarioId String?
  email     String
  sucesso   Boolean
  motivo    String?
  ip        String?
  userAgent String?
  criadoEm  DateTime @default(now())

  @@index([email, criadoEm])
}

/// Registro de atividades: tudo o que foi feito em cada cliente (protege o consultor e atende a LGPD).
model Atividade {
  id         String   @id @default(cuid())
  usuarioId  String?
  usuario    Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  clienteId  String?
  cliente    Cliente? @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  acao       String
  entidade   String?
  entidadeId String?
  descricao  String
  ip         String?
  criadoEm   DateTime @default(now())

  @@index([clienteId, criadoEm])
  @@index([criadoEm])
}

// ---------------------------------------------------------------------------
// Configurações e tabelas
// ---------------------------------------------------------------------------

model Configuracao {
  id                   String  @id @default("principal")
  nomeConsultoria      String  @default("Consultoria eSocial Doméstico")
  documento            String? // CPF ou CNPJ do consultor
  telefone             String?
  email                String?
  endereco             String?
  cidade               String?
  uf                   String?
  chavePix             String?
  nomePix              String?
  cidadePix            String?
  /// "CLT" (30 dias) ou "LC150" (tabela do art. 3º, § 3º) para férias do tempo parcial
  regraFeriasParcial   String  @default("CLT")
  diaLimiteInfo        Int     @default(30)
  diaEmissaoGuias      Int     @default(4)
  /// Meses em que uma medida disciplinar antiga ainda pesa integralmente na recomendação
  mesesPesoDisciplinar Int     @default(12)
  /// Cobrança automática das mensalidades pela API do Banco Inter (credenciais no .env)
  cobrancaInter        Boolean @default(false)
  /// Multa (%) e juros ao mês (%) das mensalidades em atraso — condição comercial do contrato
  multaMensalidade     Decimal @default(2) @db.Decimal(5, 2)
  jurosMensalidade     Decimal @default(1) @db.Decimal(5, 2)
  /// Dias após o vencimento em que o Inter cancela sozinho a cobrança não paga (0 a 60)
  diasBaixaInter       Int     @default(30)
  /// Preços sugeridos de cada plano (mensal) — usados ao cadastrar o cliente
  precoBasico          Decimal? @db.Decimal(12, 2)
  precoMedio           Decimal? @db.Decimal(12, 2)
  precoPlus            Decimal? @db.Decimal(12, 2)
  /// Plano Plus: dia de vencimento da cobrança única (mensalidade + DAE)
  diaVencimentoPlus    Int      @default(5)
  /// Plano Plus: pagar o DAE automaticamente pela API do Inter (senão, o consultor paga e marca como pago)
  pagamentoDaeInter    Boolean  @default(false)
  /// Chaves das notificações no celular, geradas sozinhas no primeiro uso quando não estão no .env
  vapidPublica         String?
  vapidPrivada         String?
}

/// Tabela única de parâmetros legais com data de vigência (histórico: uma linha por vigência).
model Parametro {
  id                String    @id @default(cuid())
  chave             String
  /// Número, texto ou faixas (JSON)
  valor             Json
  vigenciaInicio    DateTime  @db.Date
  fonteUrl          String?
  ultimaConferencia DateTime? @db.Date
  observacao        String?
  criadoPorId       String?
  criadoEm          DateTime  @default(now())
  atualizadoEm      DateTime  @updatedAt

  @@unique([chave, vigenciaInicio])
  @@index([chave])
}

/// Páginas oficiais monitoradas (aviso de possível mudança; a atualização é sempre confirmada pelo consultor).
model FonteOficial {
  id           String    @id @default(cuid())
  url          String    @unique
  hash         String?
  verificadaEm DateTime?
  mudouEm      DateTime?
  erro         String?
}

model TabelaPreco {
  id        String  @id @default(cuid())
  servico   String  @unique
  descricao String?
  valor     Decimal @db.Decimal(12, 2)
  /// "mensal", "por_empregado" ou "avulso"
  unidade   String  @default("avulso")
  ativo     Boolean @default(true)
}

model ModeloMensagem {
  id     String @id @default(cuid())
  chave  String @unique
  titulo String
  texto  String
}

// ---------------------------------------------------------------------------
// Clientes e empregados
// ---------------------------------------------------------------------------

model Cliente {
  id                 String           @id @default(cuid())
  nome               String
  cpf                String
  telefone           String?
  email              String?
  endereco           String?
  cidade             String?
  uf                 String?
  cep                String?
  inicioContrato     DateTime         @db.Date
  mensalidade        Decimal          @db.Decimal(12, 2)
  diaVencimento      Int              @default(10)
  plano              PlanoCliente     @default(BASICO)
  /// Local de trabalho (a casa), marcado pelo patrão no app; a empregada só marca o ponto dentro do raio
  localLatitude      Float?
  localLongitude     Float?
  localRaioMetros    Int              @default(10)
  localDefinidoEm    DateTime?
  procuracaoStatus   StatusProcuracao @default(PENDENTE)
  procuracaoValidade DateTime?        @db.Date
  observacoes        String?
  ativo              Boolean          @default(true)
  anonimizadoEm      DateTime?
  criadoEm           DateTime         @default(now())
  atualizadoEm       DateTime         @updatedAt

  empregados     Empregado[]
  ocorrencias    OcorrenciaDisciplinar[]
  usuarios       Usuario[]
  mensalidades   Mensalidade[]
  pagamentosDae  PagamentoDae[]
  servicos       ServicoAvulso[]
  documentos     Documento[]
  mensagens      Mensagem[]
  atividades     Atividade[]
  registrosTempo RegistroTempo[]
  arquivos       Arquivo[]

  @@index([nome])
}

model Empregado {
  id                        String            @id @default(cuid())
  clienteId                 String
  cliente                   Cliente           @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  nome                      String
  cpf                       String
  nascimento                DateTime?         @db.Date
  telefone                  String?
  funcao                    String
  cbo                       String
  admissao                  DateTime          @db.Date
  salario                   Decimal           @db.Decimal(12, 2)
  regime                    Regime            @default(INTEGRAL)
  horasSemanais             Decimal           @db.Decimal(5, 2)
  /// Horas por dia da semana: { "seg": 8, "ter": 8, ... }
  jornada                   Json
  /// Horários previstos: { "seg": { "entrada": "08:00", "saida": "17:00" } }
  horarios                  Json?
  situacao                  SituacaoEmpregado @default(ATIVO)
  desligamento              DateTime?         @db.Date
  motivoDesligamento        String?
  diasExperiencia           Int?
  acordoCompensacao         Boolean           @default(false)
  acordoIntervaloReduzido   Boolean           @default(false)
  acordo12x36               Boolean           @default(false)
  acordoViagem              Boolean           @default(false)
  residenteNoLocal          Boolean           @default(false)
  /// Primeiro dia de trabalho da escala 12x36 (para saber os dias alternados)
  referencia12x36           DateTime?         @db.Date
  toleranciaMinutos         Int               @default(5)
  dependentesSalarioFamilia Int               @default(0)
  custoValeTransporte       Decimal?          @db.Decimal(12, 2)
  gestante                  Boolean           @default(false)
  dataPrevistaParto         DateTime?         @db.Date
  estabilidadeAte           DateTime?         @db.Date
  estabilidadeMotivo        String?
  pontoAtivo                Boolean           @default(false)
  exigirSelfie              Boolean           @default(false)
  /// Horário flexível (previsto em contrato): o patrão escolhe a entrada de cada dia dentro da faixa
  horarioFlexivel           Boolean           @default(false)
  faixaInicio               String?
  faixaFim                  String?
  exigirLocalizacao         Boolean           @default(true)
  observacoes               String?
  criadoEm                  DateTime          @default(now())
  atualizadoEm              DateTime          @updatedAt

  usuario        Usuario?
  historico      HistoricoEmpregado[]
  ferias         Ferias[]
  afastamentos   Afastamento[]
  competencias   Competencia[]
  lancamentos    LancamentoMensal[]
  marcacoes      MarcacaoPonto[]
  ajustes        AjustePonto[]
  justificativas Justificativa[]
  tratamentosDia TratamentoDia[]
  escalas        EscalaDia[]
  emergencias    Emergencia[]
  espelhos       EspelhoPonto[]
  documentos     Documento[]
  ocorrencias    OcorrenciaDisciplinar[]

  @@index([clienteId])
}

model HistoricoEmpregado {
  id          String    @id @default(cuid())
  empregadoId String
  empregado   Empregado @relation(fields: [empregadoId], references: [id], onDelete: Cascade)
  data        DateTime  @db.Date
  /// ADMISSAO, ALTERACAO_SALARIAL, ALTERACAO_JORNADA, FERIAS, AFASTAMENTO, OCORRENCIA, DESLIGAMENTO
  tipo        String
  descricao   String
  criadoEm    DateTime  @default(now())

  @@index([empregadoId, data])
}

model Ferias {
  id               String    @id @default(cuid())
  empregadoId      String
  empregado        Empregado @relation(fields: [empregadoId], references: [id], onDelete: Cascade)
  inicioAquisitivo DateTime  @db.Date
  inicioGozo       DateTime  @db.Date
  dias             Int
  diasAbono        Int       @default(0)
  valorLiquido     Decimal?  @db.Decimal(12, 2)
  pagoEm           DateTime? @db.Date
  observacoes      String?
  criadoEm         DateTime  @default(now())

  @@index([empregadoId])
}

model Afastamento {
  id          String    @id @default(cuid())
  empregadoId String
  empregado   Empregado @relation(fields: [empregadoId], references: [id], onDelete: Cascade)
  /// ATESTADO, LICENCA_MATERNIDADE, AUXILIO_INCAPACIDADE, ACIDENTE_TRABALHO, OUTRO
  tipo        String
  inicio      DateTime  @db.Date
  fim         DateTime? @db.Date
  observacoes String?
  arquivoId   String?
  criadoEm    DateTime  @default(now())

  @@index([empregadoId])
}

// ---------------------------------------------------------------------------
// Rotina mensal
// ---------------------------------------------------------------------------

/// Checklist mensal por empregado.
model Competencia {
  id                         String    @id @default(cuid())
  empregadoId                String
  empregado                  Empregado @relation(fields: [empregadoId], references: [id], onDelete: Cascade)
  ano                        Int
  mes                        Int
  infoRecebida               Boolean   @default(false)
  folhaLancada               Boolean   @default(false)
  folhaEncerrada             Boolean   @default(false)
  daeEmitido                 Boolean   @default(false)
  daeEnviado                 Boolean   @default(false)
  pagamentoConfirmado        Boolean   @default(false)
  reciboArquivado            Boolean   @default(false)
  daeValor                   Decimal?  @db.Decimal(12, 2)
  daeCodigo                  String?
  daeArquivoId               String?
  pagamentoDae               PagamentoDae?
  comprovanteArquivoId       String?
  clienteInformouPagamentoEm DateTime?
  observacoes                String?
  atualizadoEm               DateTime  @updatedAt

  @@unique([empregadoId, ano, mes])
  @@index([ano, mes])
}

/// Informações do mês enviadas pelo cliente (ou geradas pelo ponto).
model LancamentoMensal {
  id                      String    @id @default(cuid())
  empregadoId             String
  empregado               Empregado @relation(fields: [empregadoId], references: [id], onDelete: Cascade)
  ano                     Int
  mes                     Int
  faltasInjustificadas    Int       @default(0)
  semanasComFalta         Int       @default(0)
  faltasJustificadas      Int       @default(0)
  atrasoMinutos           Int       @default(0)
  horasExtras50           Decimal   @default(0) @db.Decimal(8, 2)
  horasExtras100          Decimal   @default(0) @db.Decimal(8, 2)
  horasNoturnas           Decimal   @default(0) @db.Decimal(8, 2)
  horasViagem             Decimal   @default(0) @db.Decimal(8, 2)
  horasIntervaloSuprimido Decimal   @default(0) @db.Decimal(8, 2)
  diasSuspensao           Int       @default(0)
  adiantamento            Decimal   @default(0) @db.Decimal(12, 2)
  outrosProventos         Decimal   @default(0) @db.Decimal(12, 2)
  outrosDescontos         Decimal   @default(0) @db.Decimal(12, 2)
  observacoes             String?
  /// "CLIENTE", "CONSULTOR" ou "PONTO"
  origem                  String    @default("CLIENTE")
  enviadoPorId            String?
  enviadoEm               DateTime  @default(now())
  atualizadoEm            DateTime  @updatedAt

  @@unique([empregadoId, ano, mes])
}

// ---------------------------------------------------------------------------
// Ponto eletrônico (REP-P — Portaria MTP 671/2021)
// ---------------------------------------------------------------------------

/// Marcação inalterável: o banco bloqueia UPDATE e DELETE (ver migração).
model MarcacaoPonto {
  id              String       @id @default(cuid())
  /// Número sequencial do registro (NSR)
  nsr             Int          @unique @default(autoincrement())
  empregadoId     String
  empregado       Empregado    @relation(fields: [empregadoId], references: [id], onDelete: Restrict)
  tipo            TipoMarcacao
  /// Horário real da marcação (no aparelho, mesmo offline)
  dataHora        DateTime
  recebidoEm      DateTime     @default(now())
  latitude        Float?
  longitude       Float?
  precisaoMetros  Float?
  selfieArquivoId String?
  /// "ONLINE" ou "OFFLINE"
  origem          String       @default("ONLINE")
  /// Distância até o local da casa no momento da marcação (GPS) e se estava fora do raio
  distanciaMetros Float?
  foraDoLocal     Boolean      @default(false)
  dispositivo     String?
  ip              String?
  /// Identificador gerado no aparelho (evita duplicar na sincronização offline)
  idLocal         String       @unique
  hashAnterior    String?
  hash            String

  @@index([empregadoId, dataHora])
}

model AjustePonto {
  id              String            @id @default(cuid())
  empregadoId     String
  empregado       Empregado         @relation(fields: [empregadoId], references: [id], onDelete: Cascade)
  data            DateTime          @db.Date
  /// "INCLUSAO" (marcação esquecida) ou "DESCONSIDERAR" (marcação errada; a original é mantida)
  tipo            String
  marcacaoId      String?
  dataHora        DateTime?
  tipoMarcacao    TipoMarcacao?
  justificativa   String
  status          StatusSolicitacao @default(PENDENTE)
  solicitadoPorId String?
  decididoPorId   String?
  decididoEm      DateTime?
  motivoDecisao   String?
  criadoEm        DateTime          @default(now())

  @@index([empregadoId, data])
}

model Justificativa {
  id            String            @id @default(cuid())
  empregadoId   String
  empregado     Empregado         @relation(fields: [empregadoId], references: [id], onDelete: Cascade)
  data          DateTime          @db.Date
  dataFim       DateTime?         @db.Date
  /// ATESTADO_MEDICO, CASAMENTO, FALECIMENTO_FAMILIAR, DOACAO_SANGUE, VIAGEM, FOLGA_COMPENSATORIA, OUTRO
  tipo          String
  descricao     String
  arquivoId     String?
  status        StatusSolicitacao @default(PENDENTE)
  decididoPorId String?
  decididoEm    DateTime?
  criadoEm      DateTime          @default(now())

  @@index([empregadoId, data])
}

/// Horário flexível: entrada e saída de um dia, escolhidas pelo patrão (ou o horário de sempre, se ele não escolher).
model EscalaDia {
  id            String    @id @default(cuid())
  empregadoId   String
  empregado     Empregado @relation(fields: [empregadoId], references: [id], onDelete: Cascade)
  data          DateTime  @db.Date
  entrada       String
  saida         String
  /// true quando o patrão não escolheu e valeu o horário de sempre
  automatica    Boolean   @default(false)
  definidoPorId String?
  criadoEm      DateTime  @default(now())
  atualizadoEm  DateTime  @updatedAt

  @@unique([empregadoId, data])
}

/// Decisão do empregador sobre um dia com horas faltando (sem marcação ou incompleto): abonar, compensar ou descontar.
model TratamentoDia {
  id            String    @id @default(cuid())
  empregadoId   String
  empregado     Empregado @relation(fields: [empregadoId], references: [id], onDelete: Cascade)
  data          DateTime  @db.Date
  /// ABONAR, COMPENSAR ou DESCONTAR
  tratamento    String
  motivo        String?
  decididoPorId String?
  criadoEm      DateTime  @default(now())
  atualizadoEm  DateTime  @updatedAt

  @@unique([empregadoId, data])
}

model EspelhoPonto {
  id                   String    @id @default(cuid())
  empregadoId          String
  empregado            Empregado @relation(fields: [empregadoId], references: [id], onDelete: Cascade)
  ano                  Int
  mes                  Int
  resumo               Json
  hash                 String
  documentoId          String?
  geradoEm             DateTime  @default(now())
  assinadoEmpregadoEm  DateTime?
  assinadoEmpregadorEm DateTime?

  @@unique([empregadoId, ano, mes])
}

// ---------------------------------------------------------------------------
// Arquivos, documentos e assinaturas
// ---------------------------------------------------------------------------

model Arquivo {
  id          String   @id @default(cuid())
  nome        String
  mime        String
  tamanho     Int
  sha256      String
  dados       Bytes
  clienteId   String?
  cliente     Cliente? @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  criadoPorId String?
  criadoEm    DateTime @default(now())

  @@index([clienteId])
}

model Documento {
  id                       String       @id @default(cuid())
  clienteId                String
  cliente                  Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  empregadoId              String?
  empregado                Empregado?   @relation(fields: [empregadoId], references: [id], onDelete: Cascade)
  /// CONTRATO_TRABALHO, ACORDO_COMPENSACAO, ACORDO_12X36, FOLHA_PONTO, ESPELHO_PONTO, AVISO_FERIAS, RECIBO_FERIAS,
  /// AVISO_PREVIO, RECIBO_13, RECIBO_ADIANTAMENTO, RECIBO_SALARIO, CONTRATO_SERVICO, INFORME_RENDIMENTOS, DAE, COMPROVANTE, OUTRO
  tipo                     String
  titulo                   String
  arquivoId                String
  hash                     String
  competencia              String?
  exigeAssinaturaEmpregado Boolean      @default(false)
  exigeAssinaturaCliente   Boolean      @default(false)
  visivelCliente           Boolean      @default(true)
  visivelEmpregado         Boolean      @default(false)
  criadoPorId              String?
  criadoEm                 DateTime     @default(now())
  assinaturas              Assinatura[]

  @@index([clienteId, criadoEm])
  @@index([empregadoId])
}

/// Assinatura eletrônica simples (Lei 14.063/2020): identifica quem, quando, de onde e o hash do documento.
model Assinatura {
  id            String    @id @default(cuid())
  documentoId   String
  documento     Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  usuarioId     String
  usuario       Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  nome          String
  papel         Papel
  assinadoEm    DateTime  @default(now())
  ip            String?
  userAgent     String?
  hashDocumento String

  @@unique([documentoId, usuarioId])
}

// ---------------------------------------------------------------------------
// Financeiro e comercial do consultor
// ---------------------------------------------------------------------------

model Mensalidade {
  id                String         @id @default(cuid())
  clienteId         String
  cliente           Cliente        @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  ano               Int
  mes               Int
  valor             Decimal        @db.Decimal(12, 2)
  vencimento        DateTime       @db.Date
  status            StatusCobranca @default(ABERTO)
  pagoEm            DateTime?      @db.Date
  formaPagamento    String?
  txid              String?
  lembreteEnviadoEm DateTime?
  observacoes       String?
  criadoEm          DateTime       @default(now())
  /// Cobrança (boleto com Pix) emitida pela API do Banco Inter
  interCodigo       String?        @unique
  interSituacao     String?
  linhaDigitavel    String?
  pixCopiaECola     String?
  interAtualizadoEm DateTime?
  interErro         String?
  /// Plano Plus: parte da cobrança que é o DAE a repassar (soma dos DAEs dos empregados)
  valorDae          Decimal        @default(0) @db.Decimal(12, 2)
  pagamentosDae     PagamentoDae[]

  @@unique([clienteId, ano, mes])
  @@index([status, vencimento])
}

model ServicoAvulso {
  id             String         @id @default(cuid())
  clienteId      String
  cliente        Cliente        @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  /// REGULARIZACAO, RESCISAO, ADMISSAO, OUTRO
  tipo           String
  descricao      String
  valor          Decimal        @db.Decimal(12, 2)
  data           DateTime       @db.Date
  status         StatusCobranca @default(ABERTO)
  pagoEm         DateTime?      @db.Date
  formaPagamento String?
  criadoEm       DateTime       @default(now())

  @@index([clienteId])
}

model Lead {
  id             String     @id @default(cuid())
  nome           String
  telefone       String?
  email          String?
  cidade         String?
  qtdEmpregados  Int        @default(1)
  servicos       Json?
  origem         String?
  status         StatusLead @default(NOVO)
  valorProposta  Decimal?   @db.Decimal(12, 2)
  propostaEm     DateTime?
  proximoContato DateTime?  @db.Date
  observacoes    String?
  criadoEm       DateTime   @default(now())
  atualizadoEm   DateTime   @updatedAt
}

model RegistroTempo {
  id        String   @id @default(cuid())
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  usuarioId String?
  tarefa    String
  minutos   Int
  data      DateTime @db.Date
  criadoEm  DateTime @default(now())

  @@index([clienteId, data])
}

// ---------------------------------------------------------------------------
// Atendimento
// ---------------------------------------------------------------------------

model Mensagem {
  id        String    @id @default(cuid())
  clienteId String
  cliente   Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  autorId   String
  autor     Usuario   @relation(fields: [autorId], references: [id], onDelete: Cascade)
  texto     String
  criadoEm  DateTime  @default(now())
  lidaEm    DateTime?

  @@index([clienteId, criadoEm])
}

model RespostaPronta {
  id        String @id @default(cuid())
  titulo    String
  texto     String
  categoria String @default("Geral")
}

model Artigo {
  id           String   @id @default(cuid())
  titulo       String
  categoria    String
  conteudo     String
  publico      Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Gestão disciplinar (LC 150/2015, art. 27; CLT subsidiária)
// ---------------------------------------------------------------------------

model OcorrenciaDisciplinar {
  id                  String    @id @default(cuid())
  clienteId           String
  cliente             Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  empregadoId         String
  empregado           Empregado @relation(fields: [empregadoId], references: [id], onDelete: Cascade)
  dataFato            DateTime  @db.Date
  horaFato            String?
  local               String?
  /// Data em que o empregador soube da falta (conta a imediatidade)
  dataCiencia         DateTime  @db.Date
  descricao           String
  testemunhas         String?
  provasIds           String[]  @default([])
  tipoFalta           String
  gravidade           String
  versaoEmpregado     String?
  prazoDefesa         DateTime? @db.Date
  defesaRegistradaEm  DateTime?
  recomendacao        Json?
  /// ORIENTACAO_VERBAL, ADVERTENCIA_ESCRITA, SUSPENSAO, JUSTA_CAUSA, NENHUMA
  medida              String?
  diasSuspensao       Int?
  inicioSuspensao     DateTime? @db.Date
  justificativaMedida String?
  /// REGISTRADA, AGUARDANDO_DEFESA, EM_ANALISE_CONSULTOR, JUSTA_CAUSA_APROVADA, JUSTA_CAUSA_NEGADA, MEDIDA_APLICADA, ARQUIVADA
  status              String    @default("REGISTRADA")
  documentoId         String?
  documentosIds       String[]  @default([])
  assinaturaForma     String?
  recusaAssinatura    Boolean   @default(false)
  testemunhasRecusa   String?
  parecerConsultor    String?
  revisadoPorId       String?
  revisadoEm          DateTime?
  aplicadaEm          DateTime?
  criadoPorId         String?
  criadoEm            DateTime  @default(now())
  atualizadoEm        DateTime  @updatedAt

  @@index([clienteId, criadoEm])
  @@index([empregadoId, dataFato])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Avisos (notificações no app e no celular)
// ---------------------------------------------------------------------------

/// Celular/navegador que aceitou receber notificações (Web Push).
model InscricaoPush {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  criadoEm  DateTime @default(now())

  @@index([usuarioId])
}

/// Aviso para um usuário. A chave evita mandar o mesmo lembrete duas vezes.
model Notificacao {
  id        String    @id @default(cuid())
  usuarioId String
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  chave     String
  titulo    String
  texto     String
  link      String?
  lidaEm    DateTime?
  criadaEm  DateTime  @default(now())

  @@unique([usuarioId, chave])
  @@index([usuarioId, lidaEm])
}

/// Plano Plus: DAE pago pela consultoria por conta e ordem do cliente, com o dinheiro recebido dele.
model PagamentoDae {
  id             String       @id @default(cuid())
  competenciaId  String       @unique
  competencia    Competencia  @relation(fields: [competenciaId], references: [id], onDelete: Cascade)
  clienteId      String
  cliente        Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  mensalidadeId  String?
  mensalidade    Mensalidade? @relation(fields: [mensalidadeId], references: [id], onDelete: SetNull)
  valor          Decimal      @db.Decimal(12, 2)
  codigoBarras   String
  vencimento     DateTime     @db.Date
  /// AGUARDANDO_RECURSO, PRONTO, AGENDADO, AGUARDANDO_APROVACAO, PAGO, FALHA, CANCELADO
  status         String       @default("AGUARDANDO_RECURSO")
  interTransacao String?      @unique
  interStatus    String?
  agendadoPara   DateTime?    @db.Date
  pagoEm         DateTime?
  erro           String?
  criadoEm       DateTime     @default(now())
  atualizadoEm   DateTime     @updatedAt

  @@index([status])
  @@index([clienteId])
}

/// SOS acionado pela empregada (segurando o botão por 2 s): avisa os patrões e o consultor e grava o áudio em trechos.
model Emergencia {
  id            String            @id @default(cuid())
  empregadoId   String
  empregado     Empregado         @relation(fields: [empregadoId], references: [id], onDelete: Cascade)
  clienteId     String
  latitude      Float?
  longitude     Float?
  precisao      Float?
  /// ATIVA, ATENDIDA (alguém respondeu "estou indo") ou ENCERRADA
  status        String            @default("ATIVA")
  atendidaPorId String?
  atendidaPor   String?
  atendidaEm    DateTime?
  encerradaEm   DateTime?
  iniciadaEm    DateTime          @default(now())
  trechos       EmergenciaTrecho[]

  @@index([clienteId, status])
}

/// Trecho de áudio gravado durante o SOS (enviado a cada ~15 s para não perder nada).
model EmergenciaTrecho {
  id           String     @id @default(cuid())
  emergenciaId String
  emergencia   Emergencia @relation(fields: [emergenciaId], references: [id], onDelete: Cascade)
  arquivoId    String
  ordem        Int
  criadoEm     DateTime   @default(now())

  @@index([emergenciaId, ordem])
}
